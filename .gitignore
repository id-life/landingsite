npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

#yarn
yarn.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide
.idea

# Million Lint
.million

# Sentry Config File
.env.sentry-build-plugin

# Local reference documents (not for the repo)
*.docx

# Local planning docs (not for the repo), except the docs the site's code or README refers to: the performance
# budget (PERF-09), the licence register (ENG-10), the content docs (CON-10, CON-16, CON-20), the design-token guide
# (VIS-02), the device support matrix (RWD-08) and the motion inventory (MOT-08)
docs/*
!docs/performance-budget.md
!docs/licences.md
!docs/content-*.md
!docs/id-platform-content-api.md
!docs/design-tokens.md
!docs/support-matrix.md
!docs/motion-inventory.md

# Local configuration (ENG-10)
.env
.claude/settings.local.json
