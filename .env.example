# Environment variables of the site. Copy to .env for local overrides; never commit .env.
# Every NEXT_PUBLIC_ value has a public default in next.config.mjs, so a build works without any of these.
NEXT_PUBLIC_ENABLE_PREF=
# GA4 stream, per Vercel environment (DATA-15): Production = the production stream, Preview = a QA stream. Never commit it.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_DEBUG_MODE=
NEXT_PUBLIC_API_PREFIX=
# Deploy environment label for builds outside Vercel (Vercel sets VERCEL_ENV itself): production | preview | uat | local
DEPLOY_ENV=
# 1|0: force analytics on or off (default: on in production builds only). The suite's analytics build sets 1.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# 1: render Vercel Web Analytics and Speed Insights (paid beyond the plan's quota; off by default, owner decision).
NEXT_PUBLIC_VERCEL_INSIGHTS=
# 1: also mirror the key events to Vercel custom events (Vercel Pro).
NEXT_PUBLIC_VERCEL_EVENTS=
# enforce | report-only. Default: report-only on production, enforce elsewhere (security-headers.mjs).
CSP_MODE=
# Server-only. Comma-separated security.txt contacts (mailto: or https:); security.txt is 404 without one.
SECURITY_CONTACT=
# Server-only. Mailchimp Marketing API (double opt-in). Without them the route uses the public signup endpoint.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
# Cloudflare Turnstile (Invisible widget). Both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Server-only. GA4 Measurement Protocol secret: forwards load_abandon beacons to GA4 (otherwise logs only).
GA4_MP_API_SECRET=
# Who resizes next/image images: off (served as stored; the default on Vercel, where the optimizer is metered),
# next (the built-in optimizer; the default elsewhere; on Vercel this is Vercel Image Optimization, billed) or
# cdn (src/lib/image-loader.ts: CMS covers through NEXT_PUBLIC_COVER_LOADER_TEMPLATE, other images as stored).
NEXT_PUBLIC_IMAGE_OPTIMIZER=
# For cdn: URL template of a resized CMS cover, with {src} (URL-encoded), {path}, {width} and {quality}.
NEXT_PUBLIC_COVER_LOADER_TEMPLATE=
# CMS publish webhook (src/app/api/revalidate/route.ts). Server-only; the route answers 404 while unset.
REVALIDATE_SECRET=
# Baidu link push URL exactly as Baidu's console shows it for the verified property (contains site and token).
BAIDU_PUSH_ENDPOINT=
